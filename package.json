{
  "name": "knotdo",
  "displayName": "KnotDo",
  "description": "Link a KnotDo list to a workspace and work its tasks from VS Code: tick off, add, edit, and capture tasks from code.",
  "version": "0.1.0",
  "publisher": "varoindustries",
  "repository": {
    "type": "git",
    "url": "https://github.com/VAROIndustries/VSCodeKnotDoPlugin"
  },
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "KnotDo",
      "properties": {
        "knotdo.list": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Name of the KnotDo list linked to this workspace. Set it with 'KnotDo: Link List to Workspace'."
        },
        "knotdo.titlePrefix": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Only show tasks whose title starts with this (e.g. 'MyProject — '), and add it to new tasks. Use when several projects share one list."
        },
        "knotdo.apiUrl": {
          "type": "string",
          "default": "https://knotdo.app",
          "scope": "application",
          "description": "KnotDo base URL."
        },
        "knotdo.showCompleted": {
          "type": "boolean",
          "default": false,
          "description": "Show completed tasks in the tree."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "knotdo",
          "title": "KnotDo",
          "icon": "$(checklist)"
        }
      ]
    },
    "views": {
      "knotdo": [
        {
          "id": "knotdo.tasks",
          "name": "Tasks"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "knotdo.tasks",
        "contents": "Add your KnotDo API key to get started.\n[Set API Key](command:knotdo.setApiKey)",
        "when": "!knotdo.hasKey"
      },
      {
        "view": "knotdo.tasks",
        "contents": "No KnotDo list is linked to this workspace yet.\n[Link a List](command:knotdo.linkList)",
        "when": "knotdo.hasKey && !knotdo.linked"
      }
    ],
    "commands": [
      {
        "command": "knotdo.setApiKey",
        "title": "Set API Key",
        "category": "KnotDo"
      },
      {
        "command": "knotdo.linkList",
        "title": "Link List to Workspace",
        "category": "KnotDo",
        "icon": "$(link)"
      },
      {
        "command": "knotdo.refresh",
        "title": "Refresh",
        "category": "KnotDo",
        "icon": "$(refresh)"
      },
      {
        "command": "knotdo.add",
        "title": "Add Task",
        "category": "KnotDo",
        "icon": "$(add)"
      },
      {
        "command": "knotdo.addFromSelection",
        "title": "Add Task from Selection",
        "category": "KnotDo"
      },
      {
        "command": "knotdo.toggleCompleted",
        "title": "Toggle Completed Tasks",
        "category": "KnotDo",
        "icon": "$(eye)"
      },
      {
        "command": "knotdo.edit",
        "title": "Rename",
        "category": "KnotDo",
        "icon": "$(edit)"
      },
      {
        "command": "knotdo.setDue",
        "title": "Set Due Date",
        "category": "KnotDo",
        "icon": "$(calendar)"
      },
      {
        "command": "knotdo.setPriority",
        "title": "Set Priority",
        "category": "KnotDo"
      },
      {
        "command": "knotdo.editNotes",
        "title": "Edit Notes",
        "category": "KnotDo"
      },
      {
        "command": "knotdo.delete",
        "title": "Delete",
        "category": "KnotDo",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "knotdo.add",
          "when": "view == knotdo.tasks && knotdo.linked",
          "group": "navigation@1"
        },
        {
          "command": "knotdo.refresh",
          "when": "view == knotdo.tasks",
          "group": "navigation@2"
        },
        {
          "command": "knotdo.toggleCompleted",
          "when": "view == knotdo.tasks && knotdo.linked",
          "group": "navigation@3"
        },
        {
          "command": "knotdo.linkList",
          "when": "view == knotdo.tasks",
          "group": "navigation@4"
        },
        {
          "command": "knotdo.setApiKey",
          "when": "view == knotdo.tasks"
        }
      ],
      "view/item/context": [
        {
          "command": "knotdo.edit",
          "when": "view == knotdo.tasks && viewItem == task",
          "group": "inline@1"
        },
        {
          "command": "knotdo.setDue",
          "when": "view == knotdo.tasks && viewItem == task",
          "group": "inline@2"
        },
        {
          "command": "knotdo.edit",
          "when": "view == knotdo.tasks && viewItem == task",
          "group": "1@1"
        },
        {
          "command": "knotdo.editNotes",
          "when": "view == knotdo.tasks && viewItem == task",
          "group": "1@2"
        },
        {
          "command": "knotdo.setDue",
          "when": "view == knotdo.tasks && viewItem == task",
          "group": "1@3"
        },
        {
          "command": "knotdo.setPriority",
          "when": "view == knotdo.tasks && viewItem == task",
          "group": "1@4"
        },
        {
          "command": "knotdo.delete",
          "when": "view == knotdo.tasks && viewItem == task",
          "group": "2@1"
        }
      ],
      "editor/context": [
        {
          "command": "knotdo.addFromSelection",
          "when": "knotdo.linked",
          "group": "knotdo@1"
        }
      ],
      "commandPalette": [
        {
          "command": "knotdo.add",
          "when": "knotdo.linked"
        },
        {
          "command": "knotdo.addFromSelection",
          "when": "knotdo.linked && editorIsOpen"
        },
        {
          "command": "knotdo.edit",
          "when": "false"
        },
        {
          "command": "knotdo.setDue",
          "when": "false"
        },
        {
          "command": "knotdo.setPriority",
          "when": "false"
        },
        {
          "command": "knotdo.editNotes",
          "when": "false"
        },
        {
          "command": "knotdo.delete",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "test": "node test.js"
  }
}
